<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Tiny Dragon Portal Quest</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            margin: 0;
            padding: 0;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #111;
            font-family: sans-serif;
        }
        #gameCanvas {
            display: block;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(to bottom, #1a0b2e, #4c1c5c);
        }
        #hud {
            position: absolute;
            top: 15px;
            left: 15px;
            right: 15px;
            display: flex;
            justify-content: space-between;
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            text-shadow: 2px 2px 4px #000;
            pointer-events: none;
        }
        .hud-item {
            background: rgba(0, 0, 0, 0.5);
            padding: 8px 15px;
            border-radius: 20px;
            border: 2px solid #ffd700;
        }
        #timerBox {
            border-color: #ff4444;
        }
        #controls {
            position: absolute;
            bottom: 30px;
            left: 0;
            right: 0;
            height: 120px;
            display: flex;
            justify-content: space-between;
            padding: 0 40px;
            pointer-events: none;
        }
        .touch-zone {
            width: 120px;
            height: 120px;
            background: rgba(255, 255, 255, 0.15);
            border: 3px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.8);
            font-weight: bold;
            font-size: 15px;
            pointer-events: auto;
            touch-action: none;
        }
        #jumpBtn:active {
            background: rgba(255, 255, 255, 0.4);
        }
        #joystick {
            position: relative;
        }
        #stick {
            position: absolute;
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.6);
            border-radius: 50%;
            top: 32px;
            left: 32px;
            pointer-events: none;
        }
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-align: center;
            padding: 20px;
            z-index: 10;
        }
        .overlay h1 {
            font-size: 32px;
            color: #ffd700;
            margin-bottom: 15px;
        }
        .overlay p {
            font-size: 18px;
            margin-bottom: 25px;
            color: #ddd;
        }
        .btn {
            background: #e67e22;
            color: white;
            border: none;
            padding: 12px 35px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 5px 0 #b35d10;
        }
        .btn:active {
            transform: translateY(3px);
            box-shadow: 0 2px 0 #b35d10;
        }
        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <div id="hud">
        <div id="gemCount" class="hud-item">💎 Gems: 0 / 5</div>
        <div id="timerBox" class="hud-item">⏱️ Time: 60s</div>
    </div>

    <div id="startOverlay" class="overlay">
        <h1>DRAGON PORTAL QUEST</h1>
        <p>Collect all 5 Gems to unlock the portal!<br><br><b>Spyro Mechanic:</b> Tap JUMP to hop, or HOLD it mid-air to GLIDE safely across big gaps!</p>
        <button class="btn" onclick="startGame()">START GAME</button>
    </div>

    <div id="winOverlay" class="overlay hidden">
        <h1>VICTORY!</h1>
        <p>You used your wings to collect the gems and escape in time!</p>
        <button class="btn" onclick="resetGame()">PLAY AGAIN</button>
    </div>

    <div id="loseOverlay" class="overlay hidden">
        <h1>GAME OVER</h1>
        <p id="loseReason">Time ran out!</p>
        <button class="btn" onclick="resetGame()">TRY AGAIN</button>
    </div>

    <canvas id="gameCanvas"></canvas>

    <div id="controls">
        <div id="joystick" class="touch-zone">
            <div id="stick"></div>
        </div>
        <div id="jumpBtn" class="touch-zone">
            <span>JUMP</span>
            <span style="font-size:10px; font-weight:normal; margin-top:4px;">HOLD TO GLIDE</span>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        const WORLD_WIDTH = 3200;
        const WORLD_HEIGHT = 650;
        const TARGET_GEMS = 5;
        const START_TIME = 60;

        let gameState = 'start';
        let score = 0;
        let timeLeft = START_TIME;
        let timerInterval;

        const camera = { x: 0, y: 0, viewportWidth: 0, viewportHeight: 0 };

        const player = {
            x: 100, y: 300,
            width: 48, height: 48,
            vx: 0, vy: 0,
            speed: 6.5,
            jumpForce: -13.5,
            gravity: 0.55,
            glideGravity: 0.12, // Spyro slow-falling logic
            grounded: false,
            isGliding: false,
            facingRight: true,
            frameTimer: 0,
            isMoving: false
        };

        let platforms = [];
        let gems = [];
        let portal = { x: 3000, y: 420, width: 70, height: 100, active: false };

        let inputX = 0; 
        let isJoystickActive = false;
        let isJumpHeld = false;
        let joystickStart = { x: 0, y: 0 };

        function initLevel() {
            score = 0;
            timeLeft = START_TIME;
            player.x = 100; player.y = 300;
            player.vx = 0; player.vy = 0;
            player.isGliding = false;
            portal.active = false;

            // Challenging multi-tier map layout designed for gliding mechanics
            platforms = [
                { x: 0, y: 520, w: 600, h: 130 },
                { x: 750, y: 520, w: 500, h: 130 },   // Gap 1
                { x: 1400, y: 520, w: 400, h: 130 },  // Gap 2
                { x: 1950, y: 520, w: 1250, h: 130 }, // Large Final Stretches
                
                // High Floating Vantage Islands
                { x: 250, y: 380, w: 160, h: 20 },
                { x: 500, y: 260, w: 160, h: 20 },
                { x: 800, y: 360, w: 200, h: 20 },
                { x: 1100, y: 240, w: 150, h: 20 },
                { x: 1450, y: 350, w: 200, h: 20 },
                { x: 1750, y: 230, w: 150, h: 20 },
                { x: 2100, y: 360, w: 220, h: 20 },
                { x: 2450, y: 250, w: 200, h: 20 },
                { x: 2750, y: 390, w: 180, h: 20 }
            ];

            gems = [
                { x: 580, y: 200, collected: false, color: '#e74c3c' },
                { x: 1170, y: 180, collected: false, color: '#9b59b6' },
                { x: 1550, y: 290, collected: false, color: '#3498db' },
                { x: 1820, y: 150, collected: false, color: '#2ecc71' },
                { x: 2550, y: 190, collected: false, color: '#f1c40f' }
            ];

            updateHUD();
        }

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            camera.viewportWidth = canvas.width;
            camera.viewportHeight = canvas.height;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Keyboard Controls For Desktop Backups
        const keys = {};
        window.addEventListener('keydown', e => { 
            keys[e.code] = true; 
            if(e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') isJumpHeld = true;
        });
        window.addEventListener('keyup', e => { 
            keys[e.code] = false; 
            if(e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') isJumpHeld = false;
        });

        // Touch Control Triggers
        const joystickZone = document.getElementById('joystick');
        const stick = document.getElementById('stick');
        const jumpBtn = document.getElementById('jumpBtn');

        joystickZone.addEventListener('touchstart', e => {
            isJoystickActive = true;
            const rect = joystickZone.getBoundingClientRect();
            joystickStart = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        });

        joystickZone.addEventListener('touchmove', e => {
            if (!isJoystickActive) return;
            const touch = e.touches[0];
            const deltaX = touch.clientX - joystickStart.x;
            const dist = Math.min(Math.max(deltaX, -50), 50);
            stick.style.transform = `translateX(${dist}px)`;
            inputX = dist / 50;
        });

        function resetJoystick() {
            isJoystickActive = false;
            inputX = 0;
            stick.style.transform = 'translate(0px, 0px)';
        }
        joystickZone.addEventListener('touchend', resetJoystick);
        joystickZone.addEventListener('touchcancel', resetJoystick);

        jumpBtn.addEventListener('touchstart', e => {
            e.preventDefault();
            isJumpHeld = true;
            if (player.grounded && gameState === 'playing') {
                player.vy = player.jumpForce;
Use code with caution.player.grounded = false;}});jumpBtn.addEventListener('touchend', () => { isJumpHeld = false; });function startGame() {document.getElementById('startOverlay').classList.add('hidden');gameState = 'playing';initLevel();clearInterval(timerInterval);timerInterval = setInterval(() => {if (gameState === 'playing') {timeLeft--;updateHUD();if (timeLeft <= 0) endGame(false, 'Time ran out!');}}, 1000);}function endGame(isWin, message = '') {gameState = isWin ? 'win' : 'lose';clearInterval(timerInterval);if (isWin) {document.getElementById('winOverlay').classList.remove('hidden');} else {document.getElementById('loseReason').innerText = message;document.getElementById('loseOverlay').classList.remove('hidden');}}function resetGame() {document.getElementById('winOverlay').classList.add('hidden');document.getElementById('loseOverlay').classList.add('hidden');startGame();}function updateHUD() {document.getElementById('gemCount').innerText = 💎 Gems: ${score} / ${TARGET_GEMS};document.getElementById('timerBox').innerText = ⏱️ Time: ${timeLeft}s;}// Procedural Vector Sprite Rendererfunction drawDragon(ctx, x, y, width, height, facingRight, frameTimer) {ctx.save();ctx.translate(x + width / 2, y + height / 2);if (!facingRight) ctx.scale(-1, 1);let bob = 0;if (player.isMoving && player.grounded) {bob = Math.sin(frameTimer * 0.15) * 3;}// Spyro Glide Wing Animationsctx.fillStyle = '#ff793f';if (player.isGliding) {let wingFlap = Math.sin(Date.now() * 0.02) * 5;ctx.fillRect(-35, -15 + wingFlap, 22, 12); // Extended wings} else {ctx.fillRect(-22, -8 + bob, 10, 14); // Folded wings}// Tailctx.fillStyle = '#42b842';ctx.fillRect(-28, 4 + bob, 12, 10);ctx.fillStyle = '#ff9f43';ctx.fillRect(-28, 0 + bob, 4, 4);// Underbellyctx.fillStyle = '#f7f1e3';ctx.fillRect(-6, 4 + bob, 14, 16);// Main Body Torsoctx.fillStyle = '#52c452';ctx.fillRect(-14, -4 + bob, 20, 24);// Spinesctx.fillStyle = '#ff793f';ctx.fillRect(-14, -12 + bob, 6, 8);ctx.fillRect(-8, -16 + bob, 6, 8);ctx.fillRect(-2, -12 + bob, 6, 8);// Head & Snoutctx.fillStyle = '#52c452';ctx.fillRect(-2, -32 + bob, 24, 20);ctx.fillRect(10, -24 + bob, 16, 12);ctx.fillStyle = '#3ea33e';ctx.fillRect(4, -12 + bob, 16, 4);// Eyectx.fillStyle = '#ffffff';ctx.fillRect(6, -28 + bob, 6, 8);ctx.fillStyle = '#2c3e50';ctx.fillRect(8, -26 + bob, 4, 6);// Legsctx.fillStyle = '#3ea33e';if (player.isMoving && player.grounded) {let legOffset = Math.sin(frameTimer * 0.15) * 6;ctx.fillRect(-10, 20 + legOffset, 6, 8);ctx.fillRect(4, 20 - legOffset, 6, 8);} else {ctx.fillRect(-10, 20, 6, 8);ctx.fillRect(4, 20, 6, 8);}ctx.restore();}function update() {if (gameState !== 'playing') return;let moveDir = 0;if (keys['KeyA'] || keys['ArrowLeft']) moveDir = -1;else if (keys['KeyD'] || keys['ArrowRight']) moveDir = 1;else if (isJoystickActive) moveDir = inputX;if ((keys['Space'] || keys['ArrowUp'] || keys['KeyW']) && player.grounded) {player.vy = player.jumpForce;player.grounded = false;}player.isMoving = Math.abs(moveDir) > 0.1;if (player.isMoving) {player.vx = moveDir * player.speed;player.facingRight = moveDir > 0;player.frameTimer++;} else {player.vx *= 0.8;}// Spyro Glide Physics Processingif (!player.grounded && player.vy > 0 && isJumpHeld) {player.isGliding = true;player.vy = player.glideGravity; // Apply soft, slow falling downward gravity speed} else {player.isGliding = false;player.vy += player.gravity;}if (player.vy > 12) player.vy = 12;player.x += player.vx;player.y += player.vy;if (player.x < 0) player.x = 0;if (player.x > WORLD_WIDTH - player.width) player.x = WORLD_WIDTH - player.width;if (player.y > WORLD_HEIGHT) {endGame(false, 'You fell into the abyss!');return;}player.grounded = false;for (let plat of platforms) {if (player.x + player.width > plat.x &&player.x < plat.x + plat.w &&player.y + player.height > plat.y &&player.y < plat.y + plat.h) {if (player.vy > 0 && (player.y + player.height - player.vy) <= plat.y) {player.y = plat.y - player.height;player.vy = 0;player.grounded = true;}}}for (let gem of gems) {if (!gem.collected &&player.x < gem.x + 20 && player.x + player.width > gem.x - 20 &&player.y < gem.y + 20 && player.y + player.height > gem.y - 20) {gem.collected = true;score++;updateHUD();if (score >= TARGET_GEMS) {portal.active = true;}}}if (portal.active &&player.x < portal.x + portal.width && player.x + player.width > portal.x &&player.y < portal.y + portal.height && player.y + player.height > portal.y) {endGame(true);}camera.x = player.x - camera.viewportWidth / 2;camera.y = player.y - camera.viewportHeight * 0.65;if (camera.x < 0) camera.x = 0;if (camera.x > WORLD_WIDTH - camera.viewportWidth) camera.x = WORLD_WIDTH - camera.viewportWidth;if (camera.y < 0) camera.y = 0;if (camera.y > WORLD_HEIGHT - camera.viewportHeight) camera.y = WORLD_HEIGHT - camera.viewportHeight;}function draw() {ctx.clearRect(0, 0, canvas.width, canvas.height);ctx.save();ctx.translate(-camera.x, -camera.y);ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';for (let i = 0; i < 90; i++) {let starX = (i * 79) % WORLD_WIDTH;let starY = (i * 41) % WORLD_HEIGHT;ctx.fillRect(starX, starY, 2, 2);}for (let plat of platforms) {ctx.fillStyle = '#2c1930';ctx.fillRect(plat.x, plat.y, plat.w, plat.h);ctx.fillStyle = '#703080';ctx.fillRect(plat.x, plat.y, plat.w, 6);}for (let gem of gems) {if (!gem.collected) {ctx.save();ctx.shadowBlur = 15;ctx.shadowColor = gem.color;ctx.fillStyle = gem.color;ctx.beginPath();ctx.moveTo(gem.x, gem.y - 12);ctx.lineTo(gem.x + 10, gem.y);ctx.lineTo(gem.x, gem.y + 12);ctx.lineTo(gem.x - 10, gem.y);ctx.closePath();ctx.fill();ctx.restore();}}if (portal.active) {ctx.save();let pulse = Math.sin(Date.now() * 0.005) * 8;ctx.shadowBlur = 25;ctx.shadowColor = '#00ffcc';ctx.fillStyle = '#111';ctx.strokeStyle = '#00ffcc';ctx.lineWidth = 4;ctx.beginPath();ctx.ellipse(portal.x + portal.width/2, portal.y + portal.height/2, portal.width/2 + pulse/2, portal.height/2, 0, 0, Math.PI * 2);ctx.fill();ctx.stroke();ctx.restore();} else {ctx.fillStyle = '#444';ctx.fillRect(portal.x + 20, portal.y, portal.width - 40, portal.height);ctx.fillStyle = '#999';ctx.font = 'bold 12px sans-serif';ctx.fillText("LOCKED", portal.x + 10, portal.y - 15);}drawDragon(ctx, player.x, player.y, player.width, player.height, player.facingRight, player.frameTimer);ctx.restore();}function gameLoop() {update();draw();requestAnimationFrame(gameLoop);}initLevel();requestAnimationFrame(gameLoop);
