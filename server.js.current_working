import { Connection, PublicKey, Transaction, TransactionInstruction, Keypair, SystemProgram } from "@solana/web3.js";
import { getOrCreateAssociatedTokenAccount, createTransferInstruction, TOKEN_PROGRAM_ID, ASSOCIATED_TOKEN_PROGRAM_ID } from "@solana/spl-token";
import express from 'express';
import cors from 'cors';
import fs from 'fs';
import path from 'path';
const app = express();
app.use(cors());
app.use(express.json());


// Configurations
const SOLANA_RPC_URL = process.env.SOLANA_RPC_URL || 'https://api.mainnet-beta.solana.com';
const connection = new Connection(SOLANA_RPC_URL, 'confirmed');

// Core Public Keys
const treasuryAddr = process.env.TREASURY_WALLET_ADDRESS || "11111111111111111111111111111111";
const TREASURY_WALLET = new PublicKey(treasuryAddr);
let ESCROW_KEYPAIR;
try {
  ESCROW_KEYPAIR = Keypair.fromSecretKey(Uint8Array.from(JSON.parse(process.env.ESCROW_PRIVATE_KEY)));
} catch (e) {
  console.warn("⚠️ ESCROW_PRIVATE_KEY missing or invalid in environment. Generating a temporary local fallback keypair.");
  ESCROW_KEYPAIR = Keypair.generate();
}

/**
 * Endpoint to construct a serialized payment transaction (For Game Entry / Pot Deposits)
 * The client will sign and broadcast this transaction.
 */
app.post('/api/payments/create-entry-tx', async (req, res) => {
  try {
    const { playerWalletAddress, paymentType, amount } = req.body;
    
    if (!playerWalletAddress || !paymentType || !amount) {
      return res.status(400).json({ error: 'Missing required parameters' });
    }

    const playerPubKey = new PublicKey(playerWalletAddress);
    const transaction = new Transaction();

    if (paymentType === 'SOL') {
      // 1. Build SOL Transfer Instruction
      transaction.add(
        SystemProgram.transfer({
          fromPubkey: playerPubKey,
          toPubkey: TREASURY_WALLET, // Or ESCROW_KEYPAIR.publicKey if locking a pot
          lamports: amount * 1000000000, // Convert SOL to Lamports
        })
      );
    } else if (paymentType === 'MONET') {
      // 2. Build MONET Token Transfer Instruction
      // Get player and treasury Associated Token Accounts (ATAs)
      const fromTokenAccount = await getOrCreateAssociatedTokenAccount(
        connection, ESCROW_KEYPAIR, MONET_MINT, playerPubKey
      );
      const toTokenAccount = await getOrCreateAssociatedTokenAccount(
        connection, ESCROW_KEYPAIR, MONET_MINT, TREASURY_WALLET
      );

      transaction.add(
        createTransferInstruction(
          fromTokenAccount.address,
          toTokenAccount.address,
          playerPubKey,
          amount * 1000000 // Multiplied by decimals (assume 6 decimals, adjust if different)
        )
      );
    } else {
      return res.status(400).json({ error: 'Unsupported payment type' });
    }

    // Set transactional parameters
    const { blockhash, lastValidBlockHeight } = await connection.getLatestBlockhash();
    transaction.recentBlockhash = blockhash;
    transaction.feePayer = playerPubKey; // Player pays network fee

    // Serialize the transaction without signatures for client signing
    const serializedTransaction = transaction.serialize({
      requireAllSignatures: false,
      verifySignatures: false,
    });

    res.json({
      serializedTx: serializedTransaction.toString('base64'),
      blockhash,
      lastValidBlockHeight,
    });

  } catch (error) {
    console.error('Tx Creation Error:', error);
    res.status(500).json({ error: 'Failed to create payment transaction' });
  }
});


