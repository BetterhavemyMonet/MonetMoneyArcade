    res.status(500).json({ error: 'Failed to disburse tokens from escrow' });
  }
});

const __challengeStore = new Map();

function __challengeCode() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let code = '';
  for (let i = 0; i < 6; i++) {
    code += chars[Math.floor(Math.random() * chars.length)];
  }
  return code;
}

app.post('/api/challenge/create', (req, res) => {
  try {
    const { wallet, txId, game, entryFee } = req.body || {};

    if (!wallet) {
      return res.status(400).json({ ok:false, error:'wallet required' });
    }

    const code = __challengeCode();

    const challenge = {
      id: Date.now().toString(),
      code,
      game,
      entryFee,
      txId,
      status: 'open',
      createdAt: Date.now(),
      player1: { wallet, score: 0 },
      player2: null
    };

    __challengeStore.set(code, challenge);

    res.json({
      ok: true,
      challengeId: challenge.id,
      code
    });
  } catch (e) {
    res.status(500).json({ ok:false, error:e.message });
  }
});

app.get('/api/challenge/:code', (req, res) => {
  const challenge = __challengeStore.get(req.params.code);

  if (!challenge) {
    return res.status(404).json({
      ok:false,
      error:'Challenge not found'
    });
  }

  res.json({
    ok:true,
    challenge
  });
});

app.post('/api/challenge/join', (req, res) => {
  const { code, wallet, txId, paymentType } = req.body || {};

  const challenge = __challengeStore.get(code);

  if (!challenge) {
    return res.status(404).json({
      ok:false,
      error:'Challenge not found'
    });
  }

  challenge.player2 = {
    wallet,
    txId,
    paymentType,
    score: 0
  };

  challenge.status = 'active';

  res.json({
    ok:true,
    challengeId: challenge.id,
    code
  });
});


